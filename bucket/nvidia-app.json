{
    "version": "11.0.9.565",
    "description": "The NVIDIA app is the essential companion for PC gamers and creators. Keep your PC up to date with the latest NVIDIA drivers and technology.",
    "homepage": "https://www.nvidia.com/en-us/software/nvidia-app/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://www.nvidia.com/en-us/about-nvidia/eula-agreement"
    },
    "url": "https://us.download.nvidia.com/nvapp/client/11.0.9.565/NVIDIA_app_v11.0.9.565.exe#/setup.exe",
    "hash": "d70cc78e9f4d89326dd106bdaeaa01c190b9354afa3136f6543c64743139576a",
    "installer": {
        "script": [
            "if (-not ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) { throw 'Run this from an admin shell.' }",
            "$appDir = \"$env:ProgramFiles\\NVIDIA Corporation\\NVIDIA App\"",
            "$target = \"$appDir\\CEF\"",
            "$store = \"$dir\\CEF\"",
            "# Remove any existing CEF folder or junction (a junction is removed without touching its target)",
            "if (Test-Path -LiteralPath $target) {",
            "    if ((Get-Item -LiteralPath $target -Force).Attributes -band [IO.FileAttributes]::ReparsePoint) { cmd /c rmdir \"$target\" } else { Remove-Item -LiteralPath $target -Recurse -Force }",
            "}",
            "# Create the junction first so the installer writes straight into the Scoop dir",
            "New-Item -ItemType Directory -Path $store, $appDir -Force | Out-Null",
            "New-Item -ItemType Junction -Path $target -Target $store | Out-Null",
            "# Install",
            "Start-Process \"$dir\\setup.exe\" -ArgumentList '-s' -Wait -Verb RunAs | Out-Null",
            "# Verify the installer wrote into the junction and did not replace it",
            "if (!(Test-Path -LiteralPath \"$store\\*\")) { throw 'Installer did not write CEF into the junction.' }",
            "if (!((Get-Item -LiteralPath $target -Force).Attributes -band [IO.FileAttributes]::ReparsePoint)) { throw 'Installer replaced the CEF junction with a real folder.' }",
            "Remove-Item -LiteralPath \"$dir\\setup.exe\" -Force -ErrorAction SilentlyContinue"
        ]
    },
    "uninstaller": {
        "script": [
            "$appDir = \"$env:ProgramFiles\\NVIDIA Corporation\\NVIDIA App\"",
            "$target = \"$appDir\\CEF\"",
            "Get-Process -ErrorAction SilentlyContinue | Where-Object { $_.Path -like \"$appDir\\*\" } | Stop-Process -Force -ErrorAction SilentlyContinue",
            "if ((Test-Path -LiteralPath $target) -and ((Get-Item -LiteralPath $target -Force).Attributes -band [IO.FileAttributes]::ReparsePoint)) { cmd /c rmdir \"$target\" }"
        ]
    },
    "checkver": {
        "re": "NVIDIA_app(?<beta>_beta)?_v(?<version>[\\d.]+)\\.exe",
        "replace": "${version}"
    },
    "autoupdate": {
        "url": "https://us.download.nvidia.com/nvapp/client/$version/NVIDIA_app$matchBeta_v$version.exe#/setup.exe"
    }
}
