{
    "version": "11.0.9.565",
    "description": "NVIDIA app (wrapper: installs to Program Files, Scoop tracks the version)",
    "homepage": "https://www.nvidia.com/en-us/software/nvidia-app/",
    "license": "Freeware",
    "url": "https://us.download.nvidia.com/nvapp/client/11.0.9.565/NVIDIA_app_v11.0.9.565.exe#/dl.7z",
    "hash": "d70cc78e9f4d89326dd106bdaeaa01c190b9354afa3136f6543c64743139576a",
    "installer": {
        "script": [
            "Start-Process \"$dir\\setup.exe\" -ArgumentList '-s','-noreboot','-noeula','-nofinish' -Wait",
            "Get-Process setup -ErrorAction SilentlyContinue | Wait-Process"
        ]
    },
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall') {",
            "    $keys = 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*','HKLM:\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*'",
            "    $e = Get-ItemProperty $keys -ErrorAction SilentlyContinue | Where-Object DisplayName -like 'NVIDIA app*' | Select-Object -First 1",
            "    if ($e) { Start-Process cmd -ArgumentList '/c', \"$($e.UninstallString) -s\" -Wait }",
            "}"
        ]
    },
    "checkver": {
        "url": "https://www.nvidia.com/en-us/software/nvidia-app.md",
        "regex": "nvapp/client/([\\d.]+)/NVIDIA_app_v[\\d.]+\\.exe"
    },
    "autoupdate": {
        "url": "https://us.download.nvidia.com/nvapp/client/$version/NVIDIA_app_v$version.exe#/dl.7z"
    }
}