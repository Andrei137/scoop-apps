{
    "version": "11.0.9.565",
    "description": "NVIDIA app (installed into the Scoop dir, junctioned into Program Files)",
    "homepage": "https://www.nvidia.com/en-us/software/nvidia-app/",
    "license": "Freeware",
    "url": "https://us.download.nvidia.com/nvapp/client/11.0.9.565/NVIDIA_app_v11.0.9.565.exe#/setup.exe",
    "hash": "REPLACE_WITH_SHA256",
    "pre_install": [
        "$pf = \"$env:ProgramFiles\\NVIDIA Corporation\\NVIDIA App\"",
        "New-Item -ItemType Directory -Force \"$dir\\app\" | Out-Null",
        "New-Item -ItemType Directory -Force (Split-Path $pf) | Out-Null",
        "if (Test-Path $pf) { Remove-Item $pf -Recurse -Force }",
        "New-Item -ItemType Junction -Path $pf -Target \"$dir\\app\" | Out-Null"
    ],
    "installer": {
        "script": [
            "Start-Process \"$dir\\setup.exe\" -ArgumentList '-s','-noreboot','-noeula' -Wait",
            "$pf = \"$env:ProgramFiles\\NVIDIA Corporation\\NVIDIA App\"",
            "$t = (Get-Item $pf).Target",
            "if (-not $t) {",
            "    # installer replaced the junction with a real dir: move it into scoop and relink",
            "    Copy-Item \"$pf\\*\" \"$dir\\app\" -Recurse -Force",
            "    Remove-Item $pf -Recurse -Force",
            "    New-Item -ItemType Junction -Path $pf -Target \"$dir\\app\" | Out-Null",
            "}"
        ]
    },
    "pre_uninstall": [
        "Get-Process | Where-Object { $_.Path -like \"$dir\\app\\*\" } | Stop-Process -Force -ErrorAction SilentlyContinue"
    ],
    "uninstaller": {
        "script": [
            "$pf = \"$env:ProgramFiles\\NVIDIA Corporation\\NVIDIA App\"",
            "if ((Get-Item $pf -ErrorAction SilentlyContinue).Target) { (Get-Item $pf).Delete() }"
        ]
    },
    "checkver": {
        "url": "https://www.nvidia.com/en-us/software/nvidia-app/",
        "regex": "NVIDIA_app_v([\\d.]+)\\.exe"
    },
    "autoupdate": {
        "url": "https://us.download.nvidia.com/nvapp/client/$version/NVIDIA_app_v$version.exe#/setup.exe"
    }
}
