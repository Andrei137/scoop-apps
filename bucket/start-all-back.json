{
    "version": "3.9.28",
    "description": "StartAllBack. Embrace, enhance, unsweep classic UI from under the rug. For Windows 11",
    "homepage": "https://www.startallback.com/",
    "license": "Proprietary",
    "changelog": "https://www.startallback.com/",
    "url": "https://startisback.sfo3.cdn.digitaloceanspaces.com/StartAllBack_3.9.28_setup.exe#/setup.exe",
    "hash": "a760f333f6e3305e7f0e4a09982da129d01003752aa2260513a583f5e5be7b29",
    "installer": {
        "script": [
            "Move-Item \"$dir\\setup.exe\" \"$env:TEMP\\sab-setup.exe\" -Force",
            "Start-Process \"$env:TEMP\\sab-setup.exe\" -ArgumentList '/silent' -Wait",
            "$src = \"$env:LOCALAPPDATA\\StartAllBack\"",
            "if (!(Test-Path \"$src\\StartAllBackCfg.exe\")) { throw 'StartAllBack install not found' }",
            "Stop-Process -Name explorer, StartAllBackCfg -Force -ErrorAction SilentlyContinue",
            "robocopy $src $dir /E /MOVE /R:2 /W:1 /NFL /NDL /NJH /NJS | Out-Null",
            "if ($LASTEXITCODE -ge 8) { throw 'robocopy failed (files still locked?)' }",
            "cmd /c rmdir /s /q \"$src\"",
            "New-Item -ItemType Junction -Path $src -Target $dir | Out-Null",
            "if (!(Get-Process explorer -ErrorAction SilentlyContinue)) { Start-Process explorer }"
        ]
    },
    "uninstaller": {
        "script": [
            "winget uninstall -e --id StartIsBack.StartAllBack --silent",
            "if (Test-Path \"$env:LOCALAPPDATA\\StartAllBack\") { cmd /c rmdir \"$env:LOCALAPPDATA\\StartAllBack\" }"
        ]
    },
    "shortcuts": [
        [
            "StartAllBackCfg.exe",
            "StartAllBack"
        ]
    ],
    "checkver": {
        "url": "https://www.startallback.com/",
        "regex": ">Download v([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://startisback.sfo3.cdn.digitaloceanspaces.com/StartAllBack_$version_setup.exe#/setup.exe"
    }
}
