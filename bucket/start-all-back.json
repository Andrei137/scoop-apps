{
    "version": "3.9.28",
    "description": "StartAllBack. Embrace, enhance, unsweep classic UI from under the rug. For Windows 11",
    "homepage": "https://www.startallback.com/",
    "license": "Proprietary",
    "url": "https://startisback.sfo3.cdn.digitaloceanspaces.com/StartAllBack_3.9.28_setup.exe#/setup.exe",
    "hash": "a760f333f6e3305e7f0e4a09982da129d01003752aa2260513a583f5e5be7b29",
    "installer": {
        "script": [
            "Move-Item \"$dir\\setup.exe\" \"$env:TEMP\\sab-setup.exe\" -Force",
            "$link = \"$env:LOCALAPPDATA\\StartAllBack\"",
            "if (Test-Path $link) { if ((Get-Item $link).LinkType -eq 'Junction') { cmd /c rmdir \"$link\" } else { throw 'Real StartAllBack install in LOCALAPPDATA, uninstall it first' } }",
            "New-Item -ItemType Junction -Path $link -Target $dir | Out-Null",
            "$p = Start-Process \"$env:TEMP\\sab-setup.exe\" -ArgumentList '/silent' -PassThru",
            "$p.WaitForExit(60000) | Out-Null",
            "if (!(Test-Path \"$dir\\StartAllBackCfg.exe\")) { throw 'StartAllBack files not in scoop dir' }",
            "if (!$p.HasExited) { $p.Kill() }"
        ]
    },
    "uninstaller": {
        "script": [
            "winget uninstall -e --id StartIsBack.StartAllBack --silent",
            "if (Test-Path \"$env:LOCALAPPDATA\\StartAllBack\") { cmd /c rmdir \"$env:LOCALAPPDATA\\StartAllBack\" }"
        ]
    },
    "shortcuts": [
        [
            "StartAllBackCfg.exe",
            "StartAllBack"
        ]
    ],
    "checkver": {
        "url": "https://www.startallback.com/",
        "regex": ">Download v([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://startisback.sfo3.cdn.digitaloceanspaces.com/StartAllBack_$version_setup.exe#/setup.exe"
    }
}
