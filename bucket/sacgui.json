    "hash": "5b3a542d58d574167864948dfc26237da0b64152c8adcb1e54b78f09b5f81bbd",
    "pre_install": [
        "$password = 'cs.rin.ru'",
        "7z x \"$dir\\SACGUI.pkg\" \"-p$password\" \"-o$dir\" -y | Out-Null",
