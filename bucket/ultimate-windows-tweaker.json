    "hash": "7e12e5df4bae12cb21581ba157ced20e1986a0508dd10d0e8a4ab9a4cf94e85c",
    "pre_install": [
        "Remove-Item \"$dir\\placeholder.txt\" -Force",
        "$zip = \"$dir\\UWT.zip\"",
        "$ua = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36'",
        "Invoke-WebRequest 'https://www.thewindowsclub.com/downloads/UWT5.zip' -OutFile $zip -UserAgent $ua -Headers @{ Referer = 'https://www.thewindowsclub.com/' }",
        "if ((Get-FileHash $zip -Algorithm SHA256).Hash -ne '585F5A26710F303595B5210E905D93279CAB50F827F9B2F77B2E6F6A533EC1F7') { throw 'Hash check failed' }",
        "Expand-Archive $zip $dir -Force",
        "Move-Item \"$dir\\UWT 5.2\\*\" $dir -Force",
        "Remove-Item \"$dir\\UWT 5.2\", $zip -Recurse -Force"
    ],
    "bin": "Ultimate Windows Tweaker 5.2.exe",
    "shortcuts": [
        [
            "Ultimate Windows Tweaker 5.2.exe",
            "Ultimate Windows Tweaker"
        ]
    ]
}
