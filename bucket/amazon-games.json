
{
    "##": "https://www.amazongames.com/en-us/support/prime-gaming/articles/download-and-install-the-amazon-games-app?",
    "version": "3.0.9700.3",
    "description": "Amazon Games. Explore all games, loot, and more for Prime members",
    "homepage": "https://www.amazongames.com/en-us/games",
    "license": "",
    "url": "https://download.amazongames.com/AmazonGamesSetup.exe#/setup.exe",
    "hash": "b5d74ab5a63cfbef2756e9c445b1e939e51a328f17af301b5d7b9a8e9b1d4141",
    "installer": {
        "script": [
            "$source = \"$LocalAppData\\Amazon Games\"",
            "$filepath = \"$source\\App\\Amazon Games.exe\"",

            "# Run the installer if Amazon Games is missing or outdated",
            "if (!(Test-Path -LiteralPath $filepath -PathType Leaf) -or ((Get-Command $filepath -ErrorAction SilentlyContinue).Version -lt [System.Version]$version)) {",
            "    Get-Process 'Amazon Games' -ErrorAction SilentlyContinue | Stop-Process -Force",
            "    $command = \"do { Sleep 1 } until (Get-Process 'Amazon Games' -ErrorAction SilentlyContinue); Get-Process 'Amazon Games' | Stop-Process -Force\"",
            "    Start-Process -FilePath 'powershell.exe' -ArgumentList $command -WindowStyle Hidden",
            "    & \"$dir\\setup.exe\" --mode unattended | Out-Null",
            "    if (!(Test-Path -LiteralPath $filepath -PathType Leaf) -or ((Get-Command $filepath -ErrorAction SilentlyContinue).Version -lt [System.Version]$version)) {",
            "        throw 'Amazon Games installation failed or the installed version is outdated.'",
            "    }",
            "}",

            "# Remove the vendor-created desktop shortcut",
            "$programname = 'Amazon Games'",
            "$DesktopPath = [Environment]::GetFolderPath('DesktopDirectory')",
            "if (Test-Path -LiteralPath \"$DesktopPath\\$programname.lnk\") {",
            "    Remove-Item -LiteralPath \"$DesktopPath\\$programname.lnk\" -Force",
            "}",

            "# Stop Amazon Games before moving its files",
            "Get-Process 'Amazon Games' -ErrorAction SilentlyContinue | Stop-Process -Force",

            "# Move the entire installation into Scoop's active app directory",
            "$target = \"$dir\"",
            "if (Test-Path -LiteralPath $source) {",
            "    $sourceItem = Get-Item -LiteralPath $source -Force",
            "    if ($sourceItem.Attributes -band [System.IO.FileAttributes]::ReparsePoint) {",
            "        $existingTarget = (Get-Item -LiteralPath $source -Force).Target",
            "        if ($existingTarget -and ($existingTarget -contains $target)) {",
            "            # Already linked to the correct Scoop directory",
            "        } else {",
            "            throw \"Amazon Games path is already a link to a different target: $source\"",
            "        }",
            "    } else {",
            "        robocopy $source $target /E /MOVE",
            "        if ($LASTEXITCODE -ge 8) {",
            "            throw \"Robocopy failed with exit code $LASTEXITCODE. Check both directories before retrying.\"",
            "        }",
            "        Remove-Item -LiteralPath $source -Recurse -Force -ErrorAction SilentlyContinue",
            "        New-Item -ItemType Junction -Path $source -Target $target | Out-Null",
            "    }",
            "} else {",
            "    New-Item -ItemType Junction -Path $source -Target $target | Out-Null",
            "}",

            "# Remove the downloaded installer",
            "if (Test-Path -LiteralPath \"$dir\\setup.exe\") {",
            "    Remove-Item -LiteralPath \"$dir\\setup.exe\" -Force",
            "}"
        ]
    },
    "checkver": {
        "url": "https://github.com/microsoft/winget-pkgs/tree/master/manifests/a/Amazon/Games",
        "regex": "/Amazon/Games/([\\d.]+)\"",
        "reverse": true
    },
    "autoupdate": {
        "url": "https://download.amazongames.com/AmazonGamesSetup.exe#/setup.exe"
    }
}

