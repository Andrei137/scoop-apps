{
    "##": "https://www.amazongames.com/en-us/support/prime-gaming/articles/download-and-install-the-amazon-games-app?",
    "version": "3.0.9700.3",
    "description": "Amazon Games. Explore all games, loot, and more for Prime members",
    "homepage": "https://www.amazongames.com/en-us/games",
    "license": "",
    "url": "https://download.amazongames.com/AmazonGamesSetup.exe#/setup.exe",
    "hash": "b5d74ab5a63cfbef2756e9c445b1e939e51a328f17af301b5d7b9a8e9b1d4141",
    "installer": {
        "script": [
            "$source = \"$env:LOCALAPPDATA\\Amazon Games\"",
            "$exe = \"$source\\App\\Amazon Games.exe\"",

            "# If a previous junction exists, remove only the link so the installer writes to the real default location",
            "if ((Test-Path -LiteralPath $source) -and ((Get-Item -LiteralPath $source -Force).Attributes -band [IO.FileAttributes]::ReparsePoint)) {",
            "    cmd /c rmdir \"$source\"",
            "}",

            "# Install to the usual place",
            "Get-Process 'Amazon Games' -ErrorAction SilentlyContinue | Stop-Process -Force",
            "$watch = \"do { Sleep 1 } until (Get-Process 'Amazon Games' -ErrorAction SilentlyContinue); Get-Process 'Amazon Games' | Stop-Process -Force\"",
            "Start-Process powershell.exe -ArgumentList $watch -WindowStyle Hidden",
            "& \"$dir\\setup.exe\" --mode unattended | Out-Null",
            "if (!(Test-Path -LiteralPath $exe -PathType Leaf)) { throw 'Amazon Games installation failed.' }",

            "# Remove vendor desktop shortcut and stop the app",
            "Remove-Item -LiteralPath \"$([Environment]::GetFolderPath('DesktopDirectory'))\\Amazon Games.lnk\" -Force -ErrorAction SilentlyContinue",
            "Get-Process 'Amazon Games' -ErrorAction SilentlyContinue | Stop-Process -Force",

            "# Move everything into the Scoop app dir",
            "robocopy $source $dir /E /MOVE /NFL /NDL /NJH /NJS /NP | Out-Null",
            "if ($LASTEXITCODE -ge 8) { throw \"Robocopy failed with exit code $LASTEXITCODE\" }",
            "Remove-Item -LiteralPath $source -Recurse -Force -ErrorAction SilentlyContinue",

            "# Link the original location to the Scoop dir",
            "New-Item -ItemType Junction -Path $source -Target $dir | Out-Null",
            "Remove-Item -LiteralPath \"$dir\\setup.exe\" -Force -ErrorAction SilentlyContinue"
        ]
    },
    "uninstaller": {
        "script": [
            "$source = \"$env:LOCALAPPDATA\\Amazon Games\"",
            "Get-Process 'Amazon Games' -ErrorAction SilentlyContinue | Stop-Process -Force",
            "if ((Test-Path -LiteralPath $source) -and ((Get-Item -LiteralPath $source -Force).Attributes -band [IO.FileAttributes]::ReparsePoint)) { cmd /c rmdir \"$source\" }"
        ]
    },
    "checkver": {
        "url": "https://github.com/microsoft/winget-pkgs/tree/master/manifests/a/Amazon/Games",
        "regex": "/Amazon/Games/([\\d.]+)\"",
        "reverse": true
    },
    "autoupdate": {
        "url": "https://download.amazongames.com/AmazonGamesSetup.exe#/setup.exe"
    }
}
